{
  "name": "stath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run migrate:dev && bash -c 'bash scripts/dev-tunnel.sh & exec next dev'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:email-extract": "npx tsx scripts/verify-email-html-extract.ts",
    "set-commands": "bash -c 'source scripts/load-env.sh && npx tsx scripts/set-telegram-commands.ts'",
    "sync-rate": "bash -c 'source scripts/load-env.sh && npx tsx scripts/sync-boe-mortgage-rate.ts'",
    "sync-evaluate-cron-vault": "bash -c 'source scripts/load-env.sh && bash scripts/sync-evaluate-cron-vault.sh'",
    "telegram:dev": "bash scripts/telegram-webhook.sh dev",
    "telegram:prod": "bash scripts/telegram-webhook.sh prod",
    "migrate:dev": "bash scripts/migrate-dev.sh",
    "migrate:prod": "bash scripts/migrate-prod.sh",
    "deploy": "npm run migrate:prod && bash scripts/deploy.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/functions": "^3.0.0",
    "ai": "^6.0.0",
    "langmail": "^0.7.0",
    "next": "^16.0.0",
    "node-html-parser": "^7.1.0",
    "postal-mime": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cloudflared": "^0.7.1",
    "supabase": "^2.83.0",
    "typescript": "^5.7.0",
    "vercel": "^50.34.3"
  }
}
