# =============================================================================
# flat-hunter — copy to `.env.local` for local dev
# =============================================================================
# Required: fill the uncommented variables below.
# Optional: shown commented; `=` value is the built-in default (omit env → same).
# =============================================================================

# --- App URL (optional) ---
# Used by webhook/tunnel scripts. Not read by core ingest/chat logic.
# NEXT_PUBLIC_APP_URL=

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram bot (required) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CloudMailin ingest (optional but use in production) ---
# If set: HTTP Basic password must match or ingest returns 401.
# If unset: no auth check — fine for local tests; unsafe on a public URL.
# CLOUDMAILIN_SECRET=

# --- TfL commute API (optional) ---
# If unset: Journey API is called without app_id/app_key (works; may rate-limit sooner).
# TFL_APP_ID=
# TFL_APP_KEY=

# --- Mortgage (optional) ---
# If unset or empty: default rate 4.5% in finance helpers (BoE data still used where configured).
# MORTGAGE_RATE=4.5

# --- Claude model per agent (optional; defaults below) ---
# LLM_DEFAULT_MODEL=claude-haiku-4-5
# PROPERTY_EXPERT_MODEL=claude-sonnet-4-6
# AREA_EXPERT_MODEL=claude-sonnet-4-6
# CONVERSATION_MODEL=claude-haiku-4-5
# CONVERSATION_EXPLANATION_MODEL=claude-haiku-4-5
# WHY_EXPLANATION_MODEL=claude-haiku-4-5
# PREFERENCE_COLLECTOR_MODEL=claude-haiku-4-5
# INGEST_PARSE_MODEL=claude-haiku-4-5
# EMAIL_VERIFICATION_MODEL=claude-haiku-4-5
# AREA_PROFILE_MODEL=claude-haiku-4-5

# --- Property / area experts (optional) ---
# PROPERTY_EXPERT_WEB_SEARCH=true
# AREA_EXPERT_WEB_SEARCH=true
# EXPERT_MAX_TOOL_ITERATIONS=3

# --- Telegram chat agent (optional) ---
# CONVERSATION_CALL_AGENT=true
# CONVERSATION_ALLOW_RE_EVALUATION=true
# CONVERSATION_MAX_TOOL_ITERATIONS=3
# RE_EVAL_COOLDOWN_HOURS=24
# PREFERENCE_MAX_TOOL_ITERATIONS=5

# --- Area profiles on preference save (optional) ---
# AREA_PROFILE_BATCH=false

# --- Logging & UI timing (optional) ---
# LLM_USAGE_LOG=false
# SCORECARD_DELAY_MS=500

# --- Example: lower cost in prod (not defaults; edit to taste) ---
# AREA_EXPERT_WEB_SEARCH=false
# CONVERSATION_CALL_AGENT=false
# CONVERSATION_ALLOW_RE_EVALUATION=false
# AREA_PROFILE_BATCH=true
# LLM_USAGE_LOG=true
