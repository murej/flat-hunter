# Supabase. Required for saved searches and favourites.
# From Supabase Dashboard → Settings → API: Project URL and service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: use anon key instead (enable RLS and allow needed operations).
# SUPABASE_ANON_KEY=eyJ...

# Optional: secret for cron endpoint (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Optional: app origin for server-side fetch to /api/scrape (Vercel sets VERCEL_URL).
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
