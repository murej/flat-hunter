# Copy to .env.local and fill values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=
CRON_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional (defaults in code; uncomment to override) ---
# LLM_DEFAULT_MODEL=claude-haiku-4-5
# LLM_USAGE_LOG=false
# TELEGRAM_VERBOSE_MODE=false
# CLOUDMAILIN_SECRET=
# TFL_APP_ID=
# TFL_APP_KEY=
# MORTGAGE_RATE=4.5

# --- Optional model overrides ---
# PROPERTY_EXPERT_MODEL=
# AREA_EXPERT_MODEL=
# CONVERSATION_MODEL=
# WHY_EXPLANATION_MODEL=
# PREFERENCE_COLLECTOR_MODEL=
# INGEST_PARSE_MODEL=
# EMAIL_VERIFICATION_MODEL=
# AREA_PROFILE_MODEL=

# --- Evaluation throughput (Anthropic Sonnet TPM / overlap) ---
# EVALUATE_CRON_BATCH_SIZE=2
# EVALUATE_LISTING_GAP_MS=0
# EVALUATING_STALE_MINUTES=15

# --- Optional cost control flags ---
# PROPERTY_EXPERT_WEB_SEARCH=false
# AREA_EXPERT_WEB_SEARCH=false
# CONVERSATION_CALL_AGENT=true
# CONVERSATION_ALLOW_RE_EVALUATION=true
# AREA_PROFILE_BATCH=false
