ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLOUDMAILIN_SECRET=
TFL_APP_KEY=
NEXT_PUBLIC_APP_URL=

# Default mortgage rate (overrides BOE data)
MORTGAGE_RATE=

# Expert agents: set AREA_EXPERT_WEB_SEARCH=false to cut most duplicate neighbourhood web searches (recommended in production).
PROPERTY_EXPERT_WEB_SEARCH=true
AREA_EXPERT_WEB_SEARCH=true
# Max tool rounds per property/area expert (1–5). Lower reduces web search chains.
EXPERT_MAX_TOOL_ITERATIONS=3

# Area profile LLM (preference save). Default Haiku; override e.g. for A/B.
AREA_PROFILE_MODEL=claude-haiku-4-5
# Verification-email classifier (non-heuristic path). Default Haiku.
EMAIL_VERIFICATION_MODEL=claude-haiku-4-5

# Telegram conversation: set false to block nested property/area experts via call_agent (recommended in production).
CONVERSATION_CALL_AGENT=true
# Full re-evaluation from chat (expensive). Set false in production if you do not need it.
CONVERSATION_ALLOW_RE_EVALUATION=true
# Max tool rounds per Haiku conversation turn (1–5). Default 3.
CONVERSATION_MAX_TOOL_ITERATIONS=3

# Min hours between full re-evaluations from chat (0 = no limit). Default 24.
RE_EVAL_COOLDOWN_HOURS=24

# Preference collector Haiku tool rounds (1–5). Default 5.
PREFERENCE_MAX_TOOL_ITERATIONS=5

# One batched LLM call for 2+ area profiles on preference save (fallback to per-area on failure). Default false.
AREA_PROFILE_BATCH=false

# Log JSON lines with token usage per messages.create (telemetryTag + model + usage). Default false.
LLM_USAGE_LOG=false

# --- Production (cost-conscious) example ---
# Uncomment and tune to reduce spend; property web search is a product tradeoff (comps / research).
# AREA_EXPERT_WEB_SEARCH=false
# CONVERSATION_CALL_AGENT=false
# CONVERSATION_ALLOW_RE_EVALUATION=false
# AREA_PROFILE_BATCH=true
# LLM_USAGE_LOG=true
