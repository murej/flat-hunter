# Deployed URL
NEXT_PUBLIC_APP_URL=

# Optional override for Supabase Vault evaluate_cron_url (defaults to NEXT_PUBLIC_APP_URL + /api/cron/evaluate).
# npm run dev sets this from the cloudflared URL automatically.
EVALUATE_CRON_URL=

# Bearer token for GET /api/cron/evaluate (required in production when callers send Authorization).
# Must match Supabase Vault secret `cron_secret` used by pg_net (see README).
CRON_SECRET=

# Layer 1
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-haiku-4-5
LLM_USAGE_LOG=false

# Layer 2 — required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password (Dashboard → Database → Settings). Used by Supabase CLI `db push --linked` from npm dev/use:prod.
SUPABASE_DB_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VERBOSE_MODE=false

# Layer 2 — optional services
CLOUDMAILIN_SECRET=
TFL_APP_ID=
TFL_APP_KEY=
MORTGAGE_RATE=4.5

# Model overrides (all default claude-haiku-4-5)
PROPERTY_EXPERT_MODEL=
AREA_EXPERT_MODEL=
CONVERSATION_MODEL=
WHY_EXPLANATION_MODEL=
PREFERENCE_COLLECTOR_MODEL=
INGEST_PARSE_MODEL=
EMAIL_VERIFICATION_MODEL=
AREA_PROFILE_MODEL=

# Cost control flags
PROPERTY_EXPERT_WEB_SEARCH=false
AREA_EXPERT_WEB_SEARCH=false
CONVERSATION_CALL_AGENT=true
CONVERSATION_ALLOW_RE_EVALUATION=true
AREA_PROFILE_BATCH=false
